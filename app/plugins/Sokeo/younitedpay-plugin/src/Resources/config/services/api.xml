<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>

        <service id="Sokeo\SyliusYounitedpayPlugin\Api\YounitedPayApiFactory">
            <argument type="service" id="sylius.repository.payment_method" />
        </service>

        <service id="Sokeo\SyliusYounitedpayPlugin\Api\YounitedpayApi">
            <factory service="Sokeo\SyliusYounitedpayPlugin\Api\YounitedPayApiFactory"/>
        </service>

        <service id ="Sokeo\SyliusYounitedpayPlugin\Api\YounitedpayBestPrice" public="true">
            <argument type="service" id="Sokeo\SyliusYounitedpayPlugin\Api\YounitedpayApi"/>
        </service>

        <service id ="Sokeo\SyliusYounitedpayPlugin\Api\YounitedpayContract" public="true">
            <argument type="service" id="Sokeo\SyliusYounitedpayPlugin\Api\YounitedpayApi"/>
            <argument type="service" id="logger" />
        </service>
    </services>
</container>
