<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="sokeo_sylius_younitedpay_plugin.state_machine.store_maturity_processor"
                 class="Sokeo\SyliusYounitedpayPlugin\StateMachine\StoreMaturityProcessor"
                 public="true">
            <argument type="service" id="request_stack"/>
            <argument type="service" id="session.flash_bag" />
        </service>
        <service id="sokeo_sylius_younitedpay_plugin.state_machine.activate_contract_processor"
                 class="Sokeo\SyliusYounitedpayPlugin\StateMachine\ActivateContractProcessor"
                 public="true">
            <argument type="service" id="session.flash_bag" />
            <argument type="service" id="sylius.repository.order" />
            <argument type="service" key="$logger" id="logger"/>
        </service>
        <service id="sokeo_sylius_younitedpay_plugin.state_machine.cancel_contract_processor"
                 class="Sokeo\SyliusYounitedpayPlugin\StateMachine\CancelContractProcessor"
                 public="true">
            <argument type="service" id="session.flash_bag" />
            <argument type="service" key="$logger" id="logger"/>
        </service>
    </services>
</container>
