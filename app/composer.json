{
    "name": "sylius/sylius-standard",
    "type": "project",
    "description": "Starting point for projects powered by Sylius eCommerce.",
    "keywords": [
        "symfony",
        "symfony2",
        "sylius",
        "distribution",
        "ecommerce",
        "cart",
        "shopping"
    ],
    "homepage": "http://sylius.org",
    "license": "MIT",
    "authors": [
        {
            "name": "Paweł Jędrzejewski",
            "homepage": "http://pjedrzejewski.com"
        },
        {
            "name": "Sylius project",
            "homepage": "http://sylius.org"
        },
        {
            "name": "Community contributions",
            "homepage": "http://github.com/Sylius/Sylius/contributors"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-exif": "*",
        "ext-ftp": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "adyen/php-api-library": "^13.0",
        "beberlei/assert": "^3.3",
        "beberlei/doctrineextensions": "^1.3",
        "craue/formflow-bundle": "^3.6",
        "doctrine/annotations": "^1.14",
        "enqueue/gps": "^0.10.10",
        "friendsofsymfony/oauth-server-bundle": ">2.0.0-alpha.0 ^2.0@dev",
        "gedmo/doctrine-extensions": "^3.9",
        "google/apiclient": "~2.11.0",
        "google/cloud-logging": "^1.24",
        "guzzlehttp/guzzle": "^6.3",
        "incenteev/composer-parameter-handler": "^2.1",
        "lchrusciel/api-test-case": "^5.0",
        "league/flysystem-bundle": "^2.3",
        "league/flysystem-google-cloud-storage": "^2.4",
        "league/oauth2-client": "^2.6",
        "league/tactician-bundle": "^1.1",
        "league/tactician-doctrine": "^1.1",
        "mailchimp/transactional": "^1.0",
        "nelmio/cors-bundle": "^2.2",
        "nfq-eta/payum-braintree": "^1.0",
        "odolbeau/phone-number-bundle": "^3.9",
        "phpspec/phpspec": "^7.2",
        "predis/predis": "^1.1",
        "psr/container": "~1.1.1",
        "psr/link": "~1.0.0",
        "sentry/sentry-symfony": "^4.13",
        "setono/sylius-catalog-promotion-plugin": "^0.5.1",
        "setono/sylius-gift-card-plugin": "^0.11.5",
        "snc/redis-bundle": "^3.6",
        "sroze/messenger-enqueue-transport": "^0.5.1",
        "sylius-labs/sensio-distribution-bundle": "^6.0",
        "sylius/admin-api-bundle": "^1.11",
        "sylius/admin-order-creation-plugin": "~0.13.0",
        "sylius/invoicing-plugin": "^0.15",
        "sylius/sylius": "~1.10.0",
        "symfony/asset": "4.4.*",
        "symfony/dotenv": "4.4.*",
        "symfony/flex": "^1.21.0",
        "symfony/form": "4.4.*",
        "symfony/google-mailer": "4.4.*",
        "symfony/http-client": "^5.1",
        "symfony/http-foundation": "^5.4",
        "symfony/lock": "4.4.*",
        "symfony/mailer": "4.4.*",
        "symfony/monolog-bundle": "^3.3",
        "symfony/requirements-checker": "^1.1",
        "symfony/security-bundle": "4.4.*",
        "symfony/sendgrid-mailer": "4.4.*",
        "symfony/translation": "4.4.*",
        "symfony/twig-bundle": "4.4.*",
        "symfony/validator": "4.4.*",
        "symfony/webpack-encore-bundle": "^1.12",
        "twig/extensions": "^1.5",
        "zendesk/zendesk_api_client_php": "^2.2"
    },
    "conflict": {
        "sylius/sylius": ">1.11.0",
        "symfony/symfony": "*"
    },
    "require-dev": {
        "dmore/chrome-mink-driver": "^2.8",
        "ergebnis/composer-normalize": "2.14",
        "hautelook/alice-bundle": "^2.9",
        "nelmio/alice": "^3.8",
        "phparkitect/phparkitect": "^0.3.33",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-doctrine": "^1.3",
        "phpstan/phpstan-symfony": "^1.3",
        "phpstan/phpstan-webmozart-assert": "^1.2",
        "phpunit/phpunit": "^9.0",
        "rector/rector": "^1.0",
        "stripe/stripe-php": "^4.1",
        "symfony/debug-bundle": "4.4.*",
        "symfony/maker-bundle": "^1.11",
        "symfony/stopwatch": "4.4.*",
        "symfony/web-profiler-bundle": "4.4.*",
        "symplify/easy-coding-standard": "^12.1.0",
        "theofidry/alice-data-fixtures": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/thanks": false
        },
        "platform": {
            "php": "8.1"
        },
        "preferred-install": {
            "*": "dist"
        },
        "process-timeout": 0,
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.3-dev"
        },
        "symfony": {
            "allow-contrib": true,
            "require": "4.4.*"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Sokeo\\SyliusYounitedpayPlugin\\": "plugins/Sokeo/younitedpay-plugin/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "Sokeo\\SyliusYounitedpayPlugin\\Tests\\": "plugins/Sokeo/younitedpay-plugin/tests/"
        },
        "classmap": [
            "src/Kernel.php"
        ]
    },
    "prefer-stable": true,
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "post-create-project-cmd": [
            "php bin/console sylius:inform-about-gus",
            "php bin/console sylius:show-available-plugins --ansi"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "requirements-checker": "script"
        },
        "post-deploy-cmd": [
            "php bin/console sylius:install:assets",
            "php bin/console sylius:theme:assets:install"
        ]
    }
}
