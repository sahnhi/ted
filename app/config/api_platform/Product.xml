<?xml version="1.0" ?>

<resources xmlns="https://api-platform.com/schema/metadata"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="https://api-platform.com/schema/metadata https://api-platform.com/schema/metadata/metadata-2.0.xsd"
>
    <resource class="%sylius.model.product.class%" shortName="Product">
        <attribute name="validation_groups">sylius</attribute>

        <attribute name="order">
            <attribute name="code">ASC</attribute>
        </attribute>

        <collectionOperations>
            <collectionOperation name="shop_get">
                <attribute name="method">GET</attribute>
                <attribute name="path">/shop/products</attribute>
                <attribute name="filters">
                    <attribute>sylius.api.product_name_filter</attribute>
                    <attribute>sylius.api.product_order_filter</attribute>
                    <attribute>sylius.api.product_taxon_code_filter</attribute>
                    <attribute>sylius.api.translation_order_name_and_locale_filter</attribute>
                    <attribute>sylius.api.product_taxon_filter</attribute>
                    <attribute>product.filter</attribute>
                </attribute>
                <attribute name="normalization_context">
                    <attribute name="groups">shop:product:read</attribute>
                </attribute>
            </collectionOperation>
            <collectionOperation name="shop_get_menu">
                <attribute name="method">GET</attribute>
                <attribute name="path">/shop/products/menu</attribute>
                <attribute name="filters">
                    <attribute>product.filter</attribute>
                </attribute>
                <attribute name="normalization_context">
                    <attribute name="groups">shop:product:menu-read</attribute>
                </attribute>
            </collectionOperation>
            <collectionOperation name="shop_get_extended">
                <attribute name="method">GET</attribute>
                <attribute name="path">/shop/products/extended</attribute>
                <attribute name="filters">
                    <attribute>product.filter</attribute>
                    <attribute>sylius.api.product_taxon_code_filter</attribute>
                </attribute>
                <attribute name="normalization_context">
                    <attribute name="groups">
                        <attribute>shop:product:read</attribute>
                        <attribute>shop:product:read:extended</attribute>
                    </attribute>
                </attribute>
            </collectionOperation>
        </collectionOperations>

        <itemOperations>
            <itemOperation name="shop_get">
                <attribute name="method">GET</attribute>
                <attribute name="path">/shop/products/{code}</attribute>
                <attribute name="openapi_context">
                    <attribute name="summary">Use code to retrieve a product resource.</attribute>
                </attribute>
                <attribute name="normalization_context">
                    <attribute name="groups">shop:product:read</attribute>
                </attribute>
            </itemOperation>
            <itemOperation name="shop_get_extended">
                <attribute name="method">GET</attribute>
                <attribute name="path">/shop/products/{code}/extended</attribute>
                <attribute name="openapi_context">
                    <attribute name="summary">Use code to retrieve a product resource with extended informations.</attribute>
                </attribute>
                <attribute name="normalization_context">
                    <attribute name="groups">
                        <attribute>shop:product:read</attribute>
                        <attribute>shop:product:read:extended</attribute>
                    </attribute>
                </attribute>
            </itemOperation>
            <itemOperation name="shop_get_extended_options">
                <attribute name="method">GET</attribute>
                <attribute name="path">/shop/products/{code}/options</attribute>
                <attribute name="openapi_context">
                    <attribute name="summary">Use code to retrieve a product resource with extended informations.</attribute>
                </attribute>
                <attribute name="normalization_context">
                    <attribute name="groups">
                        <attribute>shop:product:read:options</attribute>
                    </attribute>
                </attribute>
            </itemOperation>
        </itemOperations>

        <property name="id" identifier="false" writable="false" />
        <property name="code" identifier="true" required="true" />
        <property name="createdAt" writable="false" />
        <property name="updatedAt" writable="false" />
        <property name="translations" readable="true" writable="true">
            <attribute name="openapi_context">
                <attribute name="type">object</attribute>
                <attribute name="example">
                    <attribute name="en_US">
                        <attribute name="name">string</attribute>
                        <attribute name="slug">string</attribute>
                        <attribute name="locale">string</attribute>
                    </attribute>
                </attribute>
            </attribute>
        </property>
        <property name="productTaxons" readable="true" writable="true" />
        <property name="options" required="false" />
        <property name="channels" required="false" />
        <property name="images" required="false" />
        <property name="mainTaxon" required="false" />
        <property name="averageRating" readable="true" />
        <property name="reviewsCount" readable="true" />

        <!-- Slow the queries too much -->
        <property name="variants" readable="false" />
        <property name="reviews" required="false" readable="false" />
    </resource>
</resources>
