<div class="ui stackable grid">
    <div class="twelve wide column">
        <div class="ui segment">
            {{ form_errors(form) }}
            {% if form.product is defined %}
                {{ form_row(form.product) }}
            {% endif %}
            {{ form_row(form.title) }}
            {{ form_row(form.comment) }}
            {{ form_row(form.rating) }}
            {{ form_row(form.locale) }}
            {{ form_row(form.status) }}
            {{ form_row(form.star) }}
            {{ form_row(form.savAnswer) }}
        </div>
    </div>
    <div class="four wide column">
        {% include '@SyliusAdmin/ProductReview/_product.html.twig' %}
        {% include '@SyliusAdmin/ProductReview/_author.html.twig' %}
        {% include '@SyliusAdmin/ProductReview/_order.html.twig' %}
        {% include '@SyliusAdmin/ProductReview/_shipping.html.twig' %}
        {% include '@SyliusAdmin/ProductReview/_answer.html.twig' %}
    </div>
</div>

