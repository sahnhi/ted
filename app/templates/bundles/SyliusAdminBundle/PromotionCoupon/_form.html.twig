<div class="ui segment">
    {{ form_errors(form) }}

    <div class="ui grid">
        <div class="height wide column">
            {{ form_row(form.code) }}
        </div>

        {{ render(url('app_admin_partial_promotion_coupon_parrain', {'coupon': promotion_coupon.code, 'template': '@SyliusAdmin/PromotionCoupon/Parrain/_infos.html.twig'})) }}
    </div>
</div>
<div class="ui segment">
    <h4 class="ui dividing header">{{ 'sylius.ui.expiration_and_usage_limits'|trans }}</h4>
    <div class="two fields">
        {{ form_row(form.usageLimit) }}
        {{ form_row(form.perCustomerUsageLimit) }}
    </div>
    <div class="two fields">
        {{ form_row(form.reusableFromCancelledOrders) }}
        {{ form_row(form.expiresAt) }}
    </div>
</div>
