{% extends '@!SyliusAdminOrderCreationPlugin/Order/selectCustomer.html.twig' %}

{% block content %}
    <div class="ui center aligned basic segment">
        {{ form_start(createCustomerForm, {'method': 'GET'})}}
        {{ form_errors(createCustomerForm) }}
        <div class="ui input fluid ">
            {{ form_widget(createCustomerForm.customerEmail, {'attr': {'placeholder': 'sylius_admin_order_creation.ui.new_customer_email'|trans}}) }}
        </div> <br /><br />
        <div class="ui input fluid ">
            {{ form_widget(createCustomerForm.customerFirstName, {'attr': {'placeholder': 'sylius.form.customer.first_name'|trans}}) }}
        </div> <br /><br />
        <div class="ui input fluid ">
            {{ form_widget(createCustomerForm.customerLastName, {'attr': {'placeholder': 'sylius.form.customer.last_name'|trans}}) }}
        </div> <br /><br />
        {{ form_row(createCustomerForm.channel, {'attr': {'class': 'ui fluid selection dropdown'}}) }} <br /><br />
        <button class="ui green right labeled icon button" id="order_create_new_customer_submit">
            <i class="plus icon"></i> {{ 'sylius_admin_order_creation.ui.create_new'|trans }}
        </button> <br /><br />
        {{ form_end(createCustomerForm) }}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
        $(document).ready(function() {
            function addErrorMessage(element, message){
                element.after(`<div class="ui red pointing label sylius-validation-error">${message}</div>`);
            }

            $('#order_create_new_customer_submit').unbind('click');
            $('#order_create_new_customer_submit').on('click', function(e) {
                e.preventDefault();

                let form = $(this).parents('form');

                let $customerEmailInput = form.find('[name*="[customerEmail]"]');
                let $customerFirstNameInput = form.find('[name*="[customerFirstName]"]');
                let $customerLastNameInput = form.find('[name*="[customerLastName]"]');
                let customerEmail = $customerEmailInput.val();
                let customerFirstName = $customerFirstNameInput.val();
                let customerLastName = $customerLastNameInput.val();
                let channelCode = form.find('[name*="[channel]"]').val();

                if (customerEmail && customerFirstName && customerLastName) {
                    form.attr('action', Routing.generate(
                            'sylius_admin_order_creation_customer_create',
                            {
                                'customerEmail': customerEmail,
                                'customerFirstName': customerFirstName,
                                'customerLastName': customerLastName,
                                'channelCode': channelCode
                            },
                            true
                    ));

                    form.submit();

                    return;
                }

                if (form.find('.sylius-validation-error').length === 0) {
                    if (!customerEmail) {
                        addErrorMessage($customerEmailInput.parent(), "{{ 'sylius_admin_order_creation.ui.customer_email'|trans }}");
                    }

                    if (!customerFirstName) {
                        addErrorMessage($customerFirstNameInput.parent(), "{{ 'sylius_admin_order_creation.ui.customer_firstname'|trans }}");
                    }

                    if (!customerLastName) {
                        addErrorMessage($customerLastNameInput.parent(), "{{ 'sylius_admin_order_creation.ui.customer_lastname'|trans }}");
                    }
                }
            });
        });
    </script>
{% endblock %}
