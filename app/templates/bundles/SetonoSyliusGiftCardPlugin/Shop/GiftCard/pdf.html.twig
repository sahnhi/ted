{% set path = '' %}
{% if configuration.backgroundImage is not empty %}
    {% set path = configuration.backgroundImage.path|imagine_filter('setono_sylius_gift_card_background') %}
{% endif %}
{% block html %}
    <html lang="{{ sylius_base_locale }}">
    <head>
        <title>Gift card: {{ giftCard.code }}</title>
        <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/normalize.css@8.0.1/normalize.min.css">
        <link href="https://fonts.googleapis.com/css?family=Roboto:300,300i,400,400i,500,500i,700,700i" rel="stylesheet" type="text/css">
        <style>
            @page {
                size: A4 landscape;
                margin: 1.5cm .5cm;
            }

            body {
                background: #fff;
                color: #282d59;
                font-family: 'Roboto', cursive;
                /*font-family: "Gill Sans Std Light",-apple-system,system-ui,Segoe UI,Roboto,Ubuntu,Cantarell,Noto Sans,sans-serif,BlinkMacSystemFont,"Segoe UI","Helvetica Neue";*/
                overflow-x: hidden;
                text-rendering: optimizeLegibility;
            }

            .container {
                margin-left: auto;
                margin-right: auto;
                padding-left: .4rem;
                padding-right: .4rem;
                width: 100%;
            }

            .page {
                border: 1px solid #cbcee8;
                display: flex;
                height: 200mm;
                position: relative;
                width: 297mm;
            }

            .page:after, .page:before {
                content: " ";
                position: absolute;
            }

            .page:before {
                border-top: .15rem dashed #cbcee8;
                height: 1px;
                left: 0;
                right: 0;
                top: 50%;
                transform: translateY(calc(-50% + 2px));
                width: 100%;
                z-index: 999;
            }

            .page:after {
                border-left: .15rem dashed #cbcee8;
                bottom: 0;
                height: 100%;
                left: 50%;
                top: 0;
                transform: translateX(-50%);
                width: 1px;
                z-index: 999;
            }

            .left, .right {
                width: 50%;
            }

            table {
                left: 0;
                right: 0;
                top: 0;
                width: 100%;
                height: 100%;
                position: relative;
            }

            table, td {
                padding: 0;
                position: relative;
            }

            td {
                vertical-align: top;
            }

            img {
                max-width: 100%;
                height: auto;
                border: 0;
            }

            .right .top .logo {
                width: 223px;
                height: 170px;
                margin-bottom: 20px;
                margin-top: 20px;
            }

            .right .top {
                text-align: center;
                align-items: center;
                display: flex;
                flex-direction: column;
                height: 50%;
                justify-content: center;
                width: 100%;
            }

            .right .bottom {
                padding: 60px;
            }

            .top:before {
                background: url(https://res.cloudinary.com/dgodjz1pn/image/upload/v1/site/gift-card/template/illu.png);
                background-repeat: no-repeat;
                content: "";
                height: 85px;
                position: absolute;
                right: 0;
                top: 75px;
                width: 100px;
            }

            p {
                margin: 0 0 1.2rem;
            }

            .right .top .line {
                letter-spacing: 1px;
                line-height: 25px;
                padding: 10px 0;
                text-align: center;
                width: 70%;
                margin: auto;
                font-size: 15px;
            }

            .right .bottom .line {
                letter-spacing: 1px;
                padding: 10px 0;
                width: 100%;
                text-align: left;
            }

            .right .bottom .line span {
                border-bottom: .05rem solid #cbcee8;
                display: inline-block;
                margin-left: 10px;
                width: inherit;
            }

            div.message {
                border: 1px solid #cbcee8;
                color: #202447;
                font-family: sans-serif;
                font-size: 14px;
                line-height: 30px;
                max-width: 100%;
                height: 150px;
                margin-top: 20px;
                padding: 20px;
            }
        </style>
    </head>

    <body>
        <div class="page">
            <table cellspacing="0" cellpadding="0">
                <tr>
                    <td class="left">
                        <img src="https://res.cloudinary.com/dgodjz1pn/image/upload/c_scale,w_1000/v1605629776/site/gift-card/template/left.png" height="722" alt="carte cadeau">
                    </td>
                    <td class="right">
                        <div class="top">
                            <img class="logo" src="data:image/png;base64," alt="">

                            <p class="line amount-desc">Votre carte cadeau d’un montant de &nbsp;&nbsp;<span class="amount">{{- giftCard.amount|sylius_format_money(giftCard.currencyCode, sylius_base_locale) -}}</span> est valable jusqu'au {{ giftCard.createdAt|date_modify("+1 year")|date("d/m/Y") }}</p>
                            <p class="line code-desc">Elle est utilisable sur tediber.com et dans les magasins Tediber avec le code :<br><span class="code">{{ giftCard.code }}</span></p>
                        </div>
                        <div class="bottom">
                            <div class="content">
                                <table>
                                    <tr>
                                        <td style="width: 110px; text-align: right; font-size:14px">Pour :</td>
                                        <td style="border-bottom: 1px solid #cbcee8; padding-left: 10px">{{ giftCard.nameRecipient }}</td>
                                    </tr>
                                </table>

                                <table style="margin-top: 20px">
                                    <tr>
                                        <td style="width: 110px; text-align: right; font-size:14px">De la part de :</td>
                                        <td style="border-bottom: 1px solid #cbcee8; padding-left: 10px">{{ giftCard.nameBuyer }}</td>
                                    </tr>
                                </table>

                                <div class="message">{{ giftCard.message }}</div>
                            </div>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </body>
    </html>
{% endblock %}
