{% import "@SyliusShop/Common/Macro/money.html.twig" as money %}

{% set shopBillingData = invoice.shopBillingData %}

{% set paymentMethod = '' %}
{% for payment in order.payments %}
    {%  if payment.state == 'completed' %}
        {% set paymentMethod = payment.method %}
    {% endif %}
{% endfor %}
{% set billingAddress = order.billingAddress %}
{% set shippingAddress = order.shippingAddress %}
{% set taxItemTotal = 0 %}
{% set subTotal = 0 %}
{% set giftCardTotal = 0 %}

{% for item in invoice.taxItems %}
    {% set taxItemTotal = taxItemTotal + item.amount %}
{% endfor %}

{% for adjustment in order.adjustments %}
    {% if adjustment.type == 'order_gift_card' %}
        {% set giftCardTotal = giftCardTotal + adjustment.amount %}
    {% endif %}
{% endfor %}

{% set ecoTaxTotal = order.ecotaxTotal %}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Facture Tediber n°{{ invoice.number }}</title>
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,300i,400,400i,500,500i,700,700i" rel="stylesheet" type="text/css">
    <style type="text/css">
        @page {
            size: A4 portrait;
            margin: 1.5cm .5cm;
        }

        body {
            height: 26.8cm;
            color: #333;
            font-family: 'Roboto', cursive;
            position: relative;
            font-size: 14px;
        }
        footer {
            font-size: 12px;
            position: absolute;
            bottom: 0;
        }

        .companyData, .billingAddress, .paymentMethod, .shippingAddress {
            font-size: 14px;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .col-12 {
            width: 100%;
        }
        .my-2 {
            margin-bottom: 10px;
            margin-top: 10px;
        }
        .my-5 {
            margin-bottom: 15px;
            margin-top: 15px;
        }

        .l-float {
            float: left;
        }
        .r-float {
            float: right;
        }
        .clear {
            clear: both;
        }

        .text-left {
            text-align: left;
        }
        .text-right {
            text-align: right;
        }
        .text-center {
            text-align: center;
        }
        .text-bold {
            font-weight: bold;
        }
        .text-italic {
            font-style: italic;
        }

        .primary-color {
            color: #6062AA;
            font-size: 16px;
        }
        .gray-color {
            color: #7f7c89;
        }

        table {
            border-collapse: collapse;
            page-break-inside: avoid;
            width: 100%;
        }
        table thead tr,
        table tbody tr {
            border: 2px solid black;
        }
        table tfoot tr {
            border-top: 1px solid black;
        }
        table thead th {
            background-color: black;
            color: white;
            padding: 5px;
        }
        table td {
            font-size: 14px;
            padding: 5px;
        }
    </style>
</head>
<body>
<header class="col-12 my-5">
    <div class="l-float" style="width:50%">
        {% if taxZone.code == 'CH' %}
            <strong>TEDIBER</strong><br>
            Paris/FR c/o Figexa Sa,<br>
            Route de Champ-colin, 12<br/>
            1260 Nyon<br/>
            Tel : 01 86 95 47 10
        {% else %}
            <strong>TEDIBER</strong><br>
            20 Rue Sainte-Croix de la Bretonnerie<br/>
            75004 PARIS<br/>
            Tel : 01 86 95 47 10
        {% endif %}
    </div>
    <div class="r-float">
        <img src="{{ invoiceLogoPath }}" alt="Tediber Logo" width="190">
    </div>

    <div class="clear"></div>
</header>

<div class="col-12 text-left primary-color my-5">
    Facture n° {{ invoice.number }} <br>
    Commande #{{ invoice.orderNumber }} <br>
    Date de commande : {{ invoice.issuedAt|date('d-m-Y') }}
</div>

<div class="col-12 text-right my-2">
    <span class="primary-color">Informations de facturation</span> <br>
    <strong>
        {% if invoice.billingData.firstName is same as (invoice.billingData.lastName) %}
            {{ invoice.billingData.firstName }}
        {% else %}
            {{ invoice.billingData.firstName }} {{ invoice.billingData.lastName }}
        {% endif %}
    </strong><br>
    {% if invoice.billingData.company %}
        {{ invoice.billingData.company }}<br/>
    {% endif %}
    {{ invoice.billingData.street }}<br/>
    {{ invoice.billingData.postcode }} {{ invoice.billingData.city }}<br/>
    {{ invoice.billingData.countryCode|sylius_country_name|upper }}
</div>

<div class="col-12 my-5">
    <table>
        <thead>
        <tr>
            <th class="text-bold text-left">Référence</th>
            <th class="text-bold text-left">Désignation</th>
            <th class="text-bold text-center" width="120px">Prix unitaire</th>
            <th class="text-bold text-center" width="60px">Quantité</th>
            <th class="text-bold text-right" width="100px">Montant TTC</th>
        </tr>
        </thead>
        <tbody>
        {% for item in invoice.lineItems %}
            <tr>
                <td class="text-left">{{ item.variantCode }}</td>
                <td class="text-left">
                    {{ item.variantName|default(item.name) }} <br>
                </td>
                <td class="text-center">
                    {{ item.unitPrice|sylius_format_money(invoice.currencyCode, invoice.localeCode) }}
                </td>
                <td class="text-center">{{ item.quantity }}</td>
                <td class="text-right">
                    {% if item.total > 0 %}
                        {{ item.total|sylius_format_money(invoice.currencyCode, invoice.localeCode) }}
                    {% else %}
                        Offert
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
        <tfoot>
        <tr>
            <td></td>
            <td class="text-bold text-right" colspan="3">Montant TTC : </td>
            <td class="text-bold text-right">{{ order.total|sylius_format_money(invoice.currencyCode, invoice.localeCode) }}</td>
        </tr>
        <tr>
            <td></td>
            <td class="text-italic text-right" colspan="3">
                <strong>Sous-total HT :</strong>
            </td>
            <td class="text-italic text-right">
                {% set subTotal = order.itemsTotal - taxItemTotal %}
                {{ subTotal|sylius_format_money(invoice.currencyCode, invoice.localeCode) }}
            </td>
        </tr>
        {% for item in invoice.taxItems %}
            <tr>
                <td></td>
                <td class="text-italic text-right" colspan="3">
                    <strong>{{ item.label }}</strong>
                </td>
                <td class="text-italic text-right">
                    {{ item.amount|sylius_format_money(invoice.currencyCode, invoice.localeCode) }}
                </td>
            </tr>
        {% endfor %}
        {% if giftCardTotal < 0 %}
            <tr>
                <td></td>
                <td class="text-italic text-right" colspan="3">
                    <strong>Montant total Carte cadeau :</strong>
                </td>
                <td class="text-italic text-right">
                    {{ giftCardTotal|sylius_format_money(invoice.currencyCode, invoice.localeCode) }}
                </td>
            </tr>
            <tr>
                <td></td>
                <td class="text-italic text-right" colspan="3">
                    <strong>Montant total TTC payé :</strong>
                </td>
                <td class="text-italic text-right">
                    {{ invoice.total|sylius_format_money(invoice.currencyCode, invoice.localeCode) }}
                </td>
            </tr>
        {% endif %}
        <tr>
            <td></td>
            <td class="text-italic text-right" colspan="3">Dont Eco-participation : </td>
            <td class="text-italic text-right">{{ money.convertAndFormat(ecoTaxTotal) }}</td>
        </tr>
        </tfoot>
    </table>
</div>

<div class="col-12 my-5">
    <div class="l-float">
        <span class="primary-color">Informations complémentaires</span> <br>
        <div class="paymentMethod">
            {% if paymentMethod.name is defined %}
            <strong>Moyen de paiement</strong> : {{ paymentMethod.name }} <br>
            {% endif %}
            <strong>Téléphone client</strong> : {{ billingAddress.phoneNumber }} <br>
            <strong>E-mail client</strong> : {{ order.customer.email }}
        </div>
    </div>

    <div class="r-float">
        {% if shippingAddress is not null %}
            <span class="primary-color">Informations de livraison</span> <br>
            <strong>
                {% if shippingAddress.firstName is same as (shippingAddress.lastName) %}
                    {{ shippingAddress.firstName }}
                {% else %}
                    {{ shippingAddress.firstName }} {{ shippingAddress.lastName }}
                {% endif %}
            </strong><br>
            {% if shippingAddress.company %}
                {{ shippingAddress.company }}<br/>
            {% endif %}
            {{ shippingAddress.street }}<br/>
            {{ shippingAddress.postcode }} {{ shippingAddress.city }}<br/>
            {{ shippingAddress.countryCode|sylius_country_name|upper }}
        {% endif %}
    </div>

    <div class="clear"></div>

    {% if taxZone.code == 'ZHUE' %}
        <p>
            <small>L’exportateur des produits couverts par le présent document déclare, sauf indication claire du contraire, ces produits ont l'origine préférentielle UE.<br>
            I HEREBY CERTIFY THAT THE INFORMATION ON THIS INVOICE IS TRUE AND CORRECT AND THE CONTENTS AND VALUE OF THIS SHIPMENT IS AS STATE ABOVE.</small>
        </p>
    {% endif %}

    {% if taxZone.code == 'CH' %}
        <p>
            <small>L’exportateur des produits couverts par le présent document déclare, sauf indication claire du contraire, ces produits ont l'origine préférentielle UE.<br>I HEREBY CERTIFY THAT THE INFORMATION ON THIS INVOICE IS TRUE AND CORRECT AND THE CONTENTS AND VALUE OF THIS SHIPMENT IS AS STATE ABOVE.</small>
        </p>
    {% endif %}
</div>


<footer class="col-12 text-center gray-color">
    {% if taxZone.code == 'CH' %}
        TEDIBER SAS
        - Siret: 8130 9638 00015 - Code NAF 7010Z <br>
        Paris/FR c/o Figexa Sa,
        Route de Champ-colin, 12 -
        1260 Nyon
        ·
        Téléphone : 01 86 95 47 10
        · <a href="https://www.tediber.com">www.tediber.com</a>
        · <a href="mailto:hello@tediber.com">hello@tediber.com</a><br>
        N° TVA : CHE-270.426.612 TVA
    {% else %}
        TEDIBER
        - Siret: 8130 9638 00015 - Code NAF 7010Z <br>
        20 rue Sainte-Croix de la Bretonnerie
        75004
        PARIS
        ·
        Téléphone : 01 86 95 47 10
        · <a href="https://www.tediber.com">www.tediber.com</a>
        · <a href="mailto:hello@tediber.com">hello@tediber.com</a><br>
        N° TVA : FR 32813089638
    {% endif %}
</footer>
</body>
</html>
