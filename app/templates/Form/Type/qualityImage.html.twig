{% extends '@SyliusUi/Form/imagesTheme.html.twig' %}

{% block _app_quality_images_entry_widget %}
    {% apply spaceless %}
        {{ form_row(form.type) }}
        <label for="{{ form.file.vars.id }}" class="ui icon labeled button"><i class="cloud upload icon"></i> {{ 'sylius.ui.choose_file'|trans }}</label>
        {% if form.vars.value.path|default(null) is not null %}
            <img class="ui big bordered image" src="{{ form.vars.value.path|imagine_filter('sylius_large') }}" alt="{{ form.vars.value.type }}" />
            <a class="ui labeled icon button " title="{{ form.vars.value.type }}" href="{{ path('app_admin_quality_image_download', {'id' : quality.id, 'image': form.vars.value.id}) }}">
                <i class="icon download"></i>
                Télécharger l'image
            </a>
        {% endif %}
        <div class="ui hidden element">
            {{ form_widget(form.file) }}
        </div>
        <div class="ui element">
            {{- form_errors(form.file) -}}
        </div>
    {% endapply %}
{% endblock %}
