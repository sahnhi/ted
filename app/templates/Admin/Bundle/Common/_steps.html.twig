{% set steps = {
    (constant('App\\Form\\Type\\Bundle\\FormSubscriber\\AddOptionsStepFormSubscriber::BUNDLE_GENERATION_STEP')): 1,
    (constant('App\\Form\\Type\\Bundle\\FormSubscriber\\AddPreviewStepFormSubscriber::BUNDLE_GENERATION_STEP')): 2,
    'naming': 3,
    'products': 4,
    'variants': 5,
} %}

<div class="ui ordered small steps top attached" style="margin-top: 25px;">
    {% for key, step in steps %}
        <div class="{% if step == flow.currentStep %} active {% elseif loop.index < flow.currentStep %} completed {% endif%} step">
            <div class="content">
                <div class="title">{{ ('app.ui.bundle_association.steps.'~ key ~'.title') | trans }}</div>
                {% if step == flow.currentStep %}
                    <div class="description">{{ ('app.ui.bundle_association.steps.'~ key ~'.sub_title') | trans }}</div>
                {% endif %}
            </div>
        </div>
    {% endfor %}
</div>
