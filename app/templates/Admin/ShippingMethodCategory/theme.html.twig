{% macro shipping_method_services_collection_item(form, allow_delete, button_delete_label, index) %}
    {% from '@SyliusAdmin/Macro/translationForm.html.twig' import translationForm %}

    {% apply spaceless %}
        <tr data-form-collection="item" data-form-collection-index="{{ index }}">
            <td>
                {{ form_row(form.enabled) }}
                {{ form_row(form.code) }}
                {{ form_row(form.productVariant) }}
                <div class="ui info message">
                    {{ 'app.ui.shipping_method_category.linked_variant_help'|trans }}
                </div>
                <div class="ui divider"></div>
                {{ form_row(form.included) }}
                <div class="ui yellow message">
                    {{ 'app.ui.shipping_method_category.included_service_help'|trans|raw }}
                </div>
                <div class="ui divider"></div>
                {{ form_row(form.restrictedProducts) }}
                <div class="ui info message">
                    {{ 'app.ui.shipping_method_category.restricted_products_help'|trans|raw }}
                </div>
            </td>
            <td>
                {{ translationForm(form.translations) }}
            </td>
            <td>
                {% if allow_delete %}
                    <a href="#" data-form-collection="delete" class="ui red labeled icon button" style="margin-bottom: 1em;">
                        <i class="trash icon"></i>
                        {{ button_delete_label|trans }}
                    </a>
                {% endif %}
            </td>
        </tr>
    {% endapply %}
{% endmacro %}

