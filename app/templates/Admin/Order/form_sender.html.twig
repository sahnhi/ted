<div class="ui segment">
    {{ form_start(form, {'action': action, 'attr': {'class': 'ui loadable form', 'novalidate': 'novalidate'}}) }}

    {{ form_row(form.bis) }}
    {{ form_row(form.parentNumber) }}
    {{ form_row(form.returnType) }}
    {{ form_row(form.return) }}

    <div class="ui styled fluid accordion">
        <div class="title active">
            <i class="dropdown icon"></i> {{ 'sylius.ui.order_reason'|trans }}
        </div>

        <div class="content active">
            {{ form_row(form.q77Notify) }}
            {{ form_row(form.orderReason) }}
        </div>

        <div class="title">
            <i class="dropdown icon"></i> {{ 'sylius.ui.items'|trans }}
        </div>
        <div id="items" class="content">
            {{ form_row(form.items) }}
        </div>

        <div class="title">
            <i class="dropdown icon"></i> {{ 'sylius.ui.shipping_address'|trans }}
            &amp; {{ 'sylius.ui.billing_address'|trans }}
        </div>
        <div class="content">
            <div class="ui horizontal segments">
                <div class="ui segment">{{ form_row(form.shippingAddress) }}</div>
                <div class="ui segment">{{ form_row(form.billingAddress) }}</div>
            </div>
        </div>
    </div>

    {% include '@SyliusUi/Form/Buttons/_create.html.twig' with {'paths': {'cancel': path('sylius_admin_order_index')}} %}

    {{ form_row(form._token) }}
    {{ form_end(form, {'render_rest': false}) }}
</div>
