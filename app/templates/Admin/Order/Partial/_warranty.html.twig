<div class="ui fluid card">
    <div class="content">
        {% for shipment in order.warrantyDays %}
            {% if shipment.days > 0 %}
                {{ shipment.days }} {{ 'app.ui.trial_period_days'|trans }}
            {% else %}
                {{ 'app.ui.end_trial_period_days'|trans }}
            {% endif %}
        {% endfor %}
    </div>
</div>
