{% extends "@App/Payum/layout.html.twig" %}

{% block payum_body %}
    <div id="paypal-container"></div>

    <input type="hidden" name="deviseFingerprinting" id="deviseFingerprinting">
{% endblock %}

{% block payum_stylesheets %}
    {{ parent() }}
    {% if environment == 'test' %}
        <link rel="stylesheet" href="https://checkoutshopper-test.adyen.com/checkoutshopper/sdk/{{ ADYEN_VERSION }}/adyen.css"
              integrity="{{ ADYEN_INTEGRITY_CSS }}"
              crossorigin="anonymous">
    {% else %}
        <link rel="stylesheet" href="https://checkoutshopper-live.adyen.com/checkoutshopper/sdk/{{ ADYEN_VERSION }}/adyen.css"
              integrity="{{ ADYEN_INTEGRITY_CSS }}"
              crossorigin="anonymous">
    {% endif %}
{% endblock %}

{% block payum_javascripts %}
    {{ parent() }}
    {% if environment == 'test' %}
        <script src="https://checkoutshopper-test.adyen.com/checkoutshopper/sdk/{{ ADYEN_VERSION }}/adyen.js"
                integrity="{{ ADYEN_INTEGRITY_JS }}"
                crossorigin="anonymous"></script>
    {% else %}
        <script src="https://checkoutshopper-live.adyen.com/checkoutshopper/sdk/{{ ADYEN_VERSION }}/adyen.js"
                integrity="{{ ADYEN_INTEGRITY_JS }}"
                crossorigin="anonymous"></script>
    {% endif %}

    <script src="https://live.adyen.com/hpp/js/df.js?v={{ "now"|date("Ymd") }}"></script>
    <script src="https://code.jquery.com/jquery-3.5.1.min.js" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>

    <script type="text/javascript">
        dfDo("deviseFingerprinting");

        const configuration = {
            environment: "{{ environment }}",
            countryCode: "{{ countryCode }}",
            amount: {{ amount|raw }},
            intent: "capture",
            merchantId: "{{ merchantId }}",
            onSubmit: (state, component) => {
                if (state.isValid) {
                    $.ajax({
                        method: "POST",
                        url: "{{ captureURL }}",
                        data: {data: state.data, deviseFingerprinting: $('#deviseFingerprinting').val()},
                    }).then(response => {
                        if (response.action) {
                            component.handleAction(response.action);
                        } else {
                            window.location = response.returnUrl;
                        }
                    }).catch(error => {
                        throw Error(error);
                    });
                }
            },
            onCancel: (data, component) => {
                component.setStatus('ready');
            },
            onError: (error, component) => {
                component.setStatus('ready');
            },
            onAdditionalDetails: (state, component) => {
                $.ajax({
                    method: "POST",
                    url: "{{ captureURL }}",
                    data: {data: state.data, deviseFingerprinting: $('#deviseFingerprinting').val()},
                }).then(response => {
                    if (response.returnUrl) {
                        window.location = response.returnUrl;
                    }
                });
            }
        };

        const checkout = new AdyenCheckout(configuration);
        const paypalComponent = checkout.create("paypal").mount('#paypal-container');
    </script>
{% endblock %}
